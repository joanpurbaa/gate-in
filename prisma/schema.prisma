// Skema sesuai docs/DATA_MODEL.md. Waktu disimpan UTC, harga Rupiah Int.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum SeatStatus {
  AVAILABLE
  HELD
  SOLD
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum TicketStatus {
  VALID
  USED
}

enum WaStatus {
  SENT
  FAILED
  SKIPPED
}

enum WaitingListStatus {
  WAITING
  OFFERED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum EventCategory {
  MUSIC
  TECH
  ARTS
  EDUCATION
  COMMUNITY
  SPORTS
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromoUsageStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

model Organizer {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  createdAt    DateTime    @default(now())
  events       Event[]
  promotions   Promotion[]
}

model Event {
  id               String      @id @default(cuid())
  organizerId      String
  organizer        Organizer   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  slug             String      @unique
  name             String
  description      String      @default("")
  posterUrl        String?
  venueName        String
  venueAddress     String?
  startsAt         DateTime
  gateOpenAt       DateTime
  gateCloseAt      DateTime
  salesOpenAt      DateTime
  salesCloseAt     DateTime
  maxSeatsPerOrder Int         @default(5)
  contactInfo      String?
  policyNote       String?
  organizerName    String?
  category         EventCategory @default(COMMUNITY)
  isFeatured       Boolean       @default(false)
  status           EventStatus   @default(DRAFT)
  /// LayoutV1 (lihat docs/SEAT_LAYOUT_SPEC.md). Null = layout belum dibuat.
  layout           Json?
  layoutLocked     Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  zones       Zone[]
  seats       Seat[]
  orders      Order[]
  tickets     Ticket[]
  waitingList WaitingListEntry[]
  promotions  Promotion[]

  @@index([organizerId])
  @@index([status])
  @@index([category])
  @@index([isFeatured])
}

model Zone {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  color     String
  price     Int
  sortOrder Int    @default(0)
  seats       Seat[]
  waitingList WaitingListEntry[]
  promotions  Promotion[]

  @@index([eventId])
}

model Seat {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zoneId    String?
  zone      Zone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  label     String
  rowLabel  String
  number    Int
  x         Float
  y         Float
  rotation  Float      @default(0)
  /// Hanya boleh diubah lewat src/lib/seats.ts
  status    SeatStatus @default(AVAILABLE)
  heldUntil DateTime?
  holdToken String?
  orderId   String?
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ticket    Ticket?

  @@unique([eventId, label])
  @@index([eventId, status])
  @@index([holdToken])
}

model Order {
  id            String      @id
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  buyerName     String
  buyerPhone    String
  status        OrderStatus @default(PENDING)
  totalAmount   Int
  originalAmount Int?
  discountAmount Int         @default(0)
  promoId       String?
  promotion     Promotion?  @relation(fields: [promoId], references: [id], onDelete: SetNull)
  promoCode     String?
  holdToken     String      @unique
  holdExpiresAt DateTime
  paymentRef        String?
  paidAt            DateTime?
  expiredAt         DateTime?
  expiredNotifiedAt DateTime?
  waStatus          WaStatus?
  waError           String?
  createdAt         DateTime    @default(now())

  seats      Seat[]
  tickets    Ticket[]
  promoUsage PromoUsage?

  @@index([eventId, status])
  @@index([status, holdExpiresAt])
  @@index([promoId])
}

model Ticket {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seatId      String       @unique
  seat        Seat         @relation(fields: [seatId], references: [id], onDelete: Cascade)
  code        String       @unique
  status      TicketStatus @default(VALID)
  checkedInAt DateTime?
  checkedInBy String?
  createdAt   DateTime     @default(now())

  @@index([eventId, status])
}

model WaitingListEntry {
  id               String            @id @default(cuid())
  eventId          String
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zoneId           String
  zone             Zone              @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  buyerName        String
  buyerPhone       String
  quantity         Int               @default(1)
  status           WaitingListStatus @default(WAITING)
  token            String            @unique
  offerExpiresAt   DateTime?
  offerNotifiedAt  DateTime?
  convertedOrderId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([eventId, zoneId, status, createdAt])
  @@index([token])
  @@index([status, offerExpiresAt])
}

model Promotion {
  id                String       @id @default(cuid())
  organizerId       String
  organizer         Organizer    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  name              String
  code              String
  description       String       @default("")
  discountType      DiscountType
  discountValue     Int
  maxDiscountAmount Int?
  minPurchaseAmount Int          @default(0)
  eventId           String?
  event             Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zoneId            String?
  zone              Zone?        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  startsAt          DateTime
  expiresAt         DateTime
  totalQuota        Int?
  maxUsesPerUser    Int          @default(1)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orders Order[]
  usages PromoUsage[]

  @@unique([organizerId, code])
  @@index([code])
  @@index([organizerId, isActive])
  @@index([eventId])
}

model PromoUsage {
  id             String           @id @default(cuid())
  promoId        String
  promotion      Promotion        @relation(fields: [promoId], references: [id], onDelete: Cascade)
  orderId        String           @unique
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerPhone     String
  discountAmount Int
  status         PromoUsageStatus @default(RESERVED)
  createdAt      DateTime         @default(now())
  confirmedAt    DateTime?
  releasedAt     DateTime?

  @@index([promoId, status])
  @@index([promoId, buyerPhone, status])
  @@index([orderId])
}

